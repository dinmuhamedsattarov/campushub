# Application Settings
APP_NAME="CampusHub API"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="change-this-super-secret-jwt-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database
POSTGRES_USER="campushub"
POSTGRES_PASSWORD="campushub_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="campushub_db"

# Redis Cache & Celery Broker
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
